{
  "name": "freeway",
  "version": "2.35.12",
  "private": true,
  "type": "module",
  "description": "Freeway — local and cloud chat for free models across providers, with model retries and local tools.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node app.mjs",
    "test": "node --test lib/*.test.mjs",
    "simulate": "node test/simulate.mjs",
    "test:cli": "node test/cli.mjs",
    "test:ui": "node test/ui-preview.mjs",
    "test:cooldown": "node test/ui-cooldown.mjs",
    "test:chatty": "node test/ui-chatty.mjs",
    "build:single": "node build/bundle.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  }
}
